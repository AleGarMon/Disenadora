:root{--bg:#f2eee8;--ink:#111;--muted:#6c6761;--paper:#fffaf4;--line:#d6cec5;--dark:#101010;--max:1220px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink);line-height:1.5}a{color:inherit;text-decoration:none}img,video{display:block;max-width:100%}.site-header{position:sticky;top:0;z-index:50;background:rgba(242,238,232,.94);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}.nav{max-width:var(--max);margin:auto;display:flex;align-items:center;justify-content:space-between;padding:14px 24px}.brand{font-weight:800;letter-spacing:.01em}.nav-right,.nav-links,.lang-switch{display:flex;align-items:center}.nav-right{gap:18px}.nav-links{gap:18px;font-size:14px}.lang-switch{gap:3px;border:1px solid var(--line);border-radius:999px;padding:3px;background:#ffffff99}.lang-btn{border:0;background:transparent;padding:7px 10px;border-radius:999px;font:inherit;font-size:12px;font-weight:800;cursor:pointer;color:var(--muted)}.lang-btn.active{background:var(--ink);color:#fff}.hero,.section,.page-head{max-width:var(--max);margin:auto;padding:72px 24px}.hero{min-height:78vh;display:grid;grid-template-columns:.92fr 1.08fr;gap:46px;align-items:center}.hero-copy{position:relative;z-index:2}.eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:11px;color:var(--muted);font-weight:700}h1{font-size:clamp(54px,8vw,108px);line-height:.88;margin:14px 0 24px;letter-spacing:-.055em}h2{font-size:clamp(38px,5vw,68px);line-height:.96;margin:0 0 20px;letter-spacing:-.04em}h3{font-size:clamp(24px,3vw,34px);margin:0 0 18px;letter-spacing:-.025em}.lead{font-size:clamp(19px,2.1vw,28px);max-width:820px}.copy{max-width:880px;color:#302c28}.cta-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.btn{display:inline-block;padding:12px 18px;border:1px solid currentColor;border-radius:999px;font-weight:700}.btn.primary{background:var(--ink);color:#fff}.hero-collage{display:grid;grid-template-columns:1.08fr .92fr;grid-template-rows:170px 150px 170px;gap:10px;transform:rotate(-1.4deg)}.hero-collage img{width:100%;height:100%;object-fit:cover;border-radius:18px;box-shadow:0 16px 36px #00000018}.hero-collage img:nth-child(1){grid-row:1/3}.hero-collage img:nth-child(4){grid-row:2/4}.hero-collage img:nth-child(5){grid-column:1/2}.hero-collage img:nth-child(6){display:none}.section.alt{background:var(--dark);color:#fff;max-width:none}.section.alt>.inner{max-width:var(--max);margin:auto}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;margin-top:34px}.card{border:1px solid var(--line);border-radius:22px;padding:28px;min-height:220px;display:flex;flex-direction:column;justify-content:flex-end;transition:.22s transform,.22s background}.card:hover{transform:translateY(-4px)}.card.dark{background:#1b1b1b;border-color:#303030}.card.dark:hover{background:#242424}.tag{font-size:12px;letter-spacing:.16em;color:#aaa}.page-head{padding-bottom:26px}.page-head h1{margin-bottom:22px}.project-block{padding:42px 0;border-top:1px solid var(--line)}.project-block:first-child{border-top:0;padding-top:0}.media-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.media-grid.compact{grid-template-columns:repeat(4,minmax(0,1fr))}.media-card{padding:0;border:0;background:none;border-radius:16px;overflow:hidden;cursor:zoom-in;aspect-ratio:4/3}.media-card img{width:100%;height:100%;object-fit:cover;transition:transform .25s}.media-card:hover img{transform:scale(1.025)}.video-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.video-card{margin:0;background:#171717;border-radius:16px;overflow:hidden;color:#fff}.video-card video{width:100%;aspect-ratio:9/16;background:#000;object-fit:contain}.video-card figcaption{padding:10px 12px;font-size:12px;color:#ccc}.small{font-size:13px;color:var(--muted);margin-top:28px}.footer{background:#111;color:#fff;padding:72px 24px}.footer .inner{max-width:var(--max);margin:auto}.contact-big{font-size:clamp(38px,7vw,86px);line-height:.94;letter-spacing:-.045em;max-width:1000px}.contact-collage{display:grid;grid-template-columns:1fr 1fr;gap:12px}.contact-collage img{height:440px;width:100%;object-fit:cover;border-radius:22px}.lightbox{position:fixed;inset:0;background:#000000e8;z-index:100;display:none;place-items:center;padding:28px}.lightbox.open{display:grid}.lightbox img{max-height:84vh;max-width:92vw;object-fit:contain}.lightbox-close{position:fixed;right:24px;top:18px;border:0;background:none;color:#fff;font-size:44px;cursor:pointer}.lightbox-caption{color:#ddd;margin-top:10px;text-align:center}.no-scroll{overflow:hidden}@media(max-width:900px){.hero{grid-template-columns:1fr;min-height:auto}.hero-collage{max-width:680px}.media-grid.compact{grid-template-columns:repeat(3,1fr)}.video-grid{grid-template-columns:repeat(2,1fr)}.nav-links{display:none}}@media(max-width:650px){.hero,.section,.page-head{padding-left:18px;padding-right:18px}.grid{grid-template-columns:1fr}.media-grid,.media-grid.compact{grid-template-columns:repeat(2,1fr)}.video-grid{grid-template-columns:1fr}.hero-collage{grid-template-rows:120px 105px 120px}.contact-collage img{height:280px}.nav{padding:12px 16px}}@media(max-width:420px){.media-grid,.media-grid.compact{grid-template-columns:1fr}.hero-collage{gap:7px}}
